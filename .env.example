MONGODB_URI="mongodb://localhost:27017/jk_crm"
JWT_SECRET="change-me-in-production-32-chars-min"
JWT_EXPIRES_IN="8h"

RESEND_API_KEY="re_your_api_key_here"
RESEND_WEBHOOK_SECRET="whsec_your_webhook_signing_secret"

FROM_EMAIL="noreply@yourdomain.com"
FROM_NAME="Your name here"
DAILY_EMAIL_LIMIT=100

# Directory (relative to project root) where uploaded files are stored
UPLOADS_DIR="./"

PORT=3001
NODE_ENV="production"
FRONTEND_URL="https://crm.yourdomain.com"

# Bootstrap: only used when the database has NO users yet.
# The first admin is created automatically on startup with mustChangePassword=true.
# Remove these after the first login and password change.
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
